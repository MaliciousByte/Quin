emit("Running advanced feature tests...");

# 1. Error Handling
attempt {
    raise "Test Error";
} rescue err {
    assert(err == "Test Error", "Rescue message failed");
} finally {
    assert(true, "Finally executed");
}

# 2. String Interning
let s1 = "intern_me";
let s2 = "intern_me";
assert(s1 == s2, "String content equality failed");

# 3. JIT hotness
task hotFunc(n) {
    return n + 1;
}

let i = 0;
while i < 1500 {
    hotFunc(i);
    i = i + 1;
}
assert(hotFunc(10) == 11, "JIT-compiled function result failed");

emit("Advanced feature tests passed!");
# Stdlib Test
emit("--- Testing Standard Library ---");

# Math
emit("sqrt(16): " + sqrt(16));
emit("pow(2, 10): " + pow(2, 10));
emit("abs(-42): " + abs(-42));
emit("floor(3.7): " + floor(3.7));
emit("ceil(3.2): " + ceil(3.2));
emit("round(3.5): " + round(3.5));
emit("min(10, 20): " + min(10, 20));
emit("max(10, 20): " + max(10, 20));
emit("PI: " + PI);

# String
emit("len(\"hello\"): " + len("hello"));
emit("upper(\"hello\"): " + upper("hello"));
emit("lower(\"HELLO\"): " + lower("HELLO"));
emit("trim(\"  hi  \"): " + trim("  hi  "));
emit("contains(\"hello world\", \"world\"): " + contains("hello world", "world"));
emit("replace(\"hello world\", \"world\", \"quin\"): " + replace("hello world", "world", "quin"));
emit("starts_with(\"hello\", \"he\"): " + starts_with("hello", "he"));
emit("ends_with(\"hello\", \"lo\"): " + ends_with("hello", "lo"));

# Type conversions
emit("to_str(42): " + to_str(42));
emit("to_int(\"123\"): " + to_int("123"));
emit("to_float(\"3.14\"): " + to_float("3.14"));

# Array
let arr = [3, 1, 4, 1, 5];
emit("Original: " + arr);
push(arr, 9);
emit("After push(9): " + arr);
let popped = pop(arr);
emit("Popped: " + popped);
sort(arr);
emit("Sorted: " + arr);
reverse(arr);
emit("Reversed: " + arr);
emit("len(arr): " + len(arr));

# Range
let r = range(5);
emit("range(5): " + r);
let r2 = range(1, 5);
emit("range(1,5): " + r2);

# Join
let words = ["hello", "world", "from", "quin"];
emit("join: " + join(words, " "));

# OS
emit("clock: " + clock());

# Type of
emit("type_of(42): " + type_of(42));
emit("type_of(3.14): " + type_of(3.14));
emit("type_of(\"hi\"): " + type_of("hi"));
emit("type_of(true): " + type_of(true));
emit("type_of(void): " + type_of(void));

emit("--- Stdlib Tests Complete ---");

# Functional Test
emit("Testing Functional...");

task square(x) => x * x;
task add(a, b) => a + b;

let result = 5 |> square |> task(val) => val + 1;
emit("Piped result: " + result); # 26
if result == 26 {
    emit("Piping: PASS");
} else {
    emit("Piping: FAIL");
}

let multiplier = task(f) => task(x) => x * f;
let triple = multiplier(3);
let val = triple(10);
emit("Closure value: " + val); # 30
if val == 30 {
    emit("Closures: PASS");
} else {
    emit("Closures: FAIL");
}

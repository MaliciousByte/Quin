# Functional Test
emit("Testing Functional...");

task square(x: int) -> int => x * x;
task add(a: int, b: int) -> int => a + b;

let result: int = 5 |> square |> task(val: int) -> int => val + 1;
emit("Piped result: " + result); # 26
if result == 26 {
    emit("Piping: PASS");
} else {
    emit("Piping: FAIL");
}

let multiplier: any = task(f: int) -> (any) => task(x: int) -> int => x * f;
let triple: any = multiplier(3);
let val: int = triple(10);
emit("Closure value: " + val); # 30
if val == 30 {
    emit("Closures: PASS");
} else {
    emit("Closures: FAIL");
}

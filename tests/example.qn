# --- ASYNC / AWAIT ---
async task fetchData() {
    return "Data from server";
}

let data = await fetchData();
emit("Async data: " + data);

# --- CASTING ---
let val: any = 42;
let num = val as int;
emit("Cast result: " + num);

# --- OPTIONAL CHAINING ---
let user: any = {"name": "John"};
emit("User name: " + user?.name);
emit("User address: " + user?.address); # Should be void/null

# --- DESTRUCTURING ---
# let { name, age } = { name: "Sajid", age: 25 };
# emit("Name: " + name);

# --- TERNARY / INLINE IF ---
let status = if 10 > 5 { "greater"; } else { "less"; };
emit("Status: " + status);

# --- STDLIB MATH ---
let result = sqrt(16.0);
emit("Square root of 16.0 is: " + result);
let p = pow(2.0, 3.0);
emit("2.0 to the power of 3.0 is: " + p);

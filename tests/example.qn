# --- COLLECTIONS ---
let scores: dict<str, int> = {"Alice": 90, "Bob": 85};
emit("Alice's score: " + scores["Alice"]);

let point: tuple<int, int>   = (10, 20);
emit("Point X: " + point[0]);

let colors: set<str> = set {"red", "green", "blue"};
emit("Color set: " + colors);

# --- ADVANCED TYPES ---
type ID = int;
let userId: ID = 12345;
emit("User ID: " + userId);

enum Status { Pending, Active, Inactive }
# Enums are stubs in compiler for now, but let's declare them.

# --- PIPE OPERATOR ---
task double(x: int) -> int { return x * 2; }
let p_res = 5 |> double;
emit("Pipe result (5 |> double): " + p_res);

# --- ERROR HANDLING ---

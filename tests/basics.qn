# Basics Test
emit("Testing Basics...");

let a: int = 10;
let b: int = 20;
let sum: int = a + b;
emit("Sum: " + sum); # Expected 30

if sum == 30 {
    emit("Addition: PASS");
} else {
    emit("Addition: FAIL");
}

let mut i: int = 0;
let mut total: int = 0;
while i < 5 {
    total = total + i;
    i = i + 1;
}
emit("Loop Total: " + total); # 0+1+2+3+4 = 10
if total == 10 {
    emit("While Loop: PASS");
} else {
    emit("While Loop: FAIL");
}

let s: str = "Hello" + " " + "World";
if s == "Hello World" {
    emit("String Concatenation: PASS");
} else {
    emit("String Concatenation: FAIL");
}

# OOP Test
emit("Testing OOP...");

trait Greeter {
    task greet();
}

class Person with Greeter {
    priv name;
    init(name) {
        self.name = name;
    }
    
    task greet() {
        emit("Hello, " + self.name);
    }
}

let p = Person("Alice");
p.greet();

class Counter {
    shared count;
    shared task increment() {
        emit("Incrementing shared member...");
    }
}

Counter.increment();
emit("OOP test complete.");

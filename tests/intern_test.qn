emit("--- Testing String Interning ---");

let s1 = "hello world";
let s2 = "hello " + "world";

emit("s1: " + s1);
emit("s2: " + s2);

# This checks pointer equality internally now
if s1 == s2 {
    emit("SUCCESS: s1 == s2 (Interned Equality)");
} else {
    emit("FAILURE: s1 != s2 (Interning failed or pointer mismatch)");
}

# Test property lookup (uses interned keys)
class Person {
    constructor(name) {
        self.name = name;
    }
}

let p = Person("Quin");
let key = "na" + "me";
emit("Accessing p[key] where key is '" + key + "': " + p.name);

if p.name == "Quin" {
    emit("SUCCESS: Property access works with interned strings");
}

emit("--- String Interning Test Done ---");
